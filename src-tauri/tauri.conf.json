{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JJaIMsae Player",
  "version": "2.0.1",
  "identifier": "com.jjaimsae.player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JJaIMsae Player",
        "width": 1500,
        "height": 960,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "m4a"
        ],
        "name": "JJaIMsae M4A Audio",
        "description": "M4A audio file",
        "role": "Viewer"
      }
    ],
    "resources": {
      "bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "bin/ffprobe.exe": "bin/ffprobe.exe"
    }
  }
}